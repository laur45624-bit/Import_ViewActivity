CREATE Procedure [dbo].[spImport_ViewingActivity_Client]	
							@ImportedDocumentId			UniqueIdentifier	= null,
							@Debug						Char(1)				= 'N',
							@CasinoInsightDatabaseName	VarChar(100)		= Null,
							@RetrieveCoreCodeOnly		BIT					= 0
							
as
set nocount on
Declare @Sql nvarchar(max)

 -- 4.6 or later passes @CasinoInsightDatabaseName automatically so we don't need to loop anymore

BEGIN

Set Nocount On

-- Update raw data with ImportedDocumentId
if IsNull(@Debug, 'N') = 'N'
	Update	NetflixVA_Raw_Client
	Set	ImportedDocumentId = @ImportedDocumentId
	Where	ImportedDocumentId Is Null


-- Create temp table (#RawData) matching the NetflixVA_Raw_Client import table
Select	ID
		,Dur			
		,WD			
		,PN			
		,Country			
		,BM			
		,LBM					
		,SVT				
		,Atr					
		,DT				
		,Title
		,CONVERT(time,NULL)				Dur_Converted
		,CONVERT(datetime,NULL)			WD_Converted
		,CONVERT(time,NULL)				BM_Convereted
		,CAST(NULL AS varchar(100))		Series_MovieName
		,CAST(NULL AS varchar(100))		Season
		,CAST(NULL AS varchar(100))		EpisodeName
		,ImportedDocumentId
Into	#RawData
From	NetflixVA_Raw_Client
Where	NetflixVA_Raw_Client.ImportedDocumentId = @ImportedDocumentId
And	Title Not Like '%[_]%'

---------------------------------------------------------------------------
-- update convereted columns
---------------------------------------------------------------------------
Update #RawData
Set Dur_Converted				=			CONVERT(time, Dur)	
Update #RawData
Set WD_Converted				=			CONVERT(datetime, WD)		
Update #RawData
Set BM_Convereted				=			CONVERT(time, BM)

----------------------------------------------------------------------------------------
-- split title name into series/movie, season, and episode based on ':' delimiter
----------------------------------------------------------------------------------------
Update #RawData
Set Series_MovieName	=	CASE
								WHEN CHARINDEX(':', Title) > 0
								THEN LTRIM(RTRIM(LEFT(Title,CHARINDEX(':',Title) - 1)))
								ELSE LTRIM(RTRIM(Title))
							END
Update #RawData
Set Season				=	CASE
								WHEN LEN(Title) - LEN(REPLACE(Title, ':', '')) >= 2 -- two colons used
								THEN LTRIM(RTRIM(SUBSTRING(Title,CHARINDEX(':', Title) + 1,CHARINDEX(':', Title, CHARINDEX(':', Title) + 1) - CHARINDEX(':', Title) - 1)))
								WHEN CHARINDEX(':', Title) > 0 AND LEN(Title) - LEN(REPLACE(Title, ':', '')) = 1
								THEN LTRIM(RTRIM(SUBSTRING(Title,CHARINDEX(':', Title) + 1, LEN(Title))))
								ELSE NULL
							END
Update #RawData
Set EpisodeName			=	CASE
								WHEN LEN(Title) - LEN(REPLACE(Title, ':', '')) >= 2
								THEN LTRIM(RTRIM(SUBSTRING(Title,CHARINDEX(':', Title, CHARINDEX(':', Title) + 1) + 1, LEN(Title))))
								ELSE NULL
							END


-- update ImportedDocument Set RowsInserted = 0 Where SourceTableId = 144
if IsNull(@Debug, 'N') = 'N'
	select @Sql = N'Update	'+@CasinoInsightDatabaseName+'..ImportedDocument
	Set	RowsInserted = ( Select Count(1) From #RawData  )
	Where	ImportedDocument.Id = @ImportedDocumentId
	'
execute sp_executeSQL @sql, N'@ImportedDocumentId UniqueIdentifier', @ImportedDocumentId


-- Insert into NetflixVA_Client with all required columns
-- Ensure target table has required split columns
IF COL_LENGTH('dbo.NetflixVA_Client','Series Name') IS NULL
	ALTER TABLE dbo.NetflixVA_Client ADD [Series Name] varchar(100) NULL
IF COL_LENGTH('dbo.NetflixVA_Client','Season') IS NULL
	ALTER TABLE dbo.NetflixVA_Client ADD [Season] varchar(100) NULL
IF COL_LENGTH('dbo.NetflixVA_Client','Episode') IS NULL
	ALTER TABLE dbo.NetflixVA_Client ADD [Episode] varchar(100) NULL

If IsNull(@Debug, 'N') = 'N'
	Begin
		Select @Sql = N'
			Insert dbo.NetflixVA_Client
			(
				ID
				,Duration				
				,WatchDate				
				,ProfileName				
				,Country						
				,Bookmark						
				,SupplementalVideoType	
				,Attributes				
				,DeviceType				
				,Title
				,[Series Name]
				,[Season]
				,[Episode]
				,ImportedDocumentId		
			)
			Select	
				 R.ID
				,R.Dur_Converted			
				,R.WD_Converted
				,R.PN
				,R.Country
				,R.BM_Convereted
				,R.SVT
				,R.Atr
				,R.DT
				,R.Title
				,R.Series_MovieName
				,R.Season
				,R.EpisodeName
				,R.ImportedDocumentId
			From	#RawData R
			Where Not Exists ( Select 1 From dbo.NetflixVA_Client (NoLock) C Where C.ImportedDocumentId = @ImportedDocumentId And C.ID = R.ID)
		'
				EXEC sp_executesql @Sql, N'@ImportedDocumentId UniqueIdentifier', @ImportedDocumentId

		-- Backfill legacy columns for compatibility
		IF COL_LENGTH('dbo.NetflixVA_Client','Series_MovieName') IS NOT NULL
			UPDATE C SET C.Series_MovieName = C.[Series Name]
			FROM dbo.NetflixVA_Client C
			WHERE C.ImportedDocumentId = @ImportedDocumentId
		IF COL_LENGTH('dbo.NetflixVA_Client','EpisodeName') IS NOT NULL
			UPDATE C SET C.EpisodeName = C.[Episode]
			FROM dbo.NetflixVA_Client C
			WHERE C.ImportedDocumentId = @ImportedDocumentId

		End
	Else
	Select * From NetflixVA_Client

--SET IDENTITY_INSERT CreditCardCashAdvanceCashClub OFF

End

--get rid of any temp table abominations that have been created
Drop Table #RawData
